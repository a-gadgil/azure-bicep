{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "11924177520620170796"
    },
    "name": "Go App Deployment (Modular with Loops & Conditionals)",
    "description": "Orchestrates networking, compute (with loops), and storage (conditional)",
    "version": "1.0.0"
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "eastus"
    },
    "environment": {
      "type": "string",
      "defaultValue": "dev"
    },
    "vmCount": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "maxValue": 5
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_B2s",
      "allowedValues": [
        "Standard_B1s",
        "Standard_B2s"
      ]
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "azureuser"
    },
    "adminPassword": {
      "type": "securestring"
    },
    "deployStorage": {
      "type": "bool",
      "defaultValue": false
    },
    "tags": {
      "type": "object",
      "defaultValue": {}
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "networkingDeployment",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "tags": {
            "value": "[parameters('tags')]"
          },
          "environment": {
            "value": "[parameters('environment')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.48.1.52935",
              "templateHash": "11358369573554966692"
            },
            "name": "Networking Module",
            "description": "VNet, Subnet, NSG",
            "version": "1.0.0"
          },
          "parameters": {
            "location": {
              "type": "string"
            },
            "environment": {
              "type": "string"
            },
            "tags": {
              "type": "object",
              "defaultValue": {}
            }
          },
          "variables": {
            "vnetName": "[format('{0}-vnet', parameters('environment'))]",
            "subnetName": "[format('{0}-subnet', parameters('environment'))]",
            "nsgName": "[format('{0}-nsg', parameters('environment'))]"
          },
          "resources": [
            {
              "type": "Microsoft.Network/networkSecurityGroups",
              "apiVersion": "2023-05-01",
              "name": "[variables('nsgName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "securityRules": [
                  {
                    "name": "AllowSSH",
                    "properties": {
                      "protocol": "Tcp",
                      "sourcePortRange": "*",
                      "destinationPortRange": "22",
                      "sourceAddressPrefix": "*",
                      "destinationAddressPrefix": "*",
                      "access": "Allow",
                      "priority": 1000,
                      "direction": "Inbound"
                    }
                  },
                  {
                    "name": "AllowHTTP",
                    "properties": {
                      "protocol": "Tcp",
                      "sourcePortRange": "*",
                      "destinationPortRange": "80",
                      "sourceAddressPrefix": "*",
                      "destinationAddressPrefix": "*",
                      "access": "Allow",
                      "priority": 1001,
                      "direction": "Inbound"
                    }
                  }
                ]
              }
            },
            {
              "type": "Microsoft.Network/virtualNetworks",
              "apiVersion": "2023-05-01",
              "name": "[variables('vnetName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "addressSpace": {
                  "addressPrefixes": [
                    "10.0.0.0/16"
                  ]
                },
                "subnets": [
                  {
                    "name": "[variables('subnetName')]",
                    "properties": {
                      "addressPrefix": "10.0.1.0/24",
                      "networkSecurityGroup": {
                        "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
                      }
                    }
                  }
                ]
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
              ]
            }
          ],
          "outputs": {
            "vnetId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
            },
            "vnetName": {
              "type": "string",
              "value": "[variables('vnetName')]"
            },
            "subnetId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Network/virtualNetworks', variables('vnetName')), '2023-05-01').subnets[0].id]"
            },
            "subnetName": {
              "type": "string",
              "value": "[variables('subnetName')]"
            },
            "nsgId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
            },
            "nsgName": {
              "type": "string",
              "value": "[variables('nsgName')]"
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "computeDeployment",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "environment": {
            "value": "[parameters('environment')]"
          },
          "vmCount": {
            "value": "[parameters('vmCount')]"
          },
          "vmSize": {
            "value": "[parameters('vmSize')]"
          },
          "adminUsername": {
            "value": "[parameters('adminUsername')]"
          },
          "adminPassword": {
            "value": "[parameters('adminPassword')]"
          },
          "subnetId": {
            "value": "[reference(resourceId('Microsoft.Resources/deployments', 'networkingDeployment'), '2025-04-01').outputs.subnetId.value]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.48.1.52935",
              "templateHash": "17825100467430070650"
            },
            "name": "Compute Module",
            "description": "VMs and NICs (with loop support)",
            "version": "1.0.0"
          },
          "parameters": {
            "location": {
              "type": "string"
            },
            "environment": {
              "type": "string"
            },
            "vmCount": {
              "type": "int",
              "defaultValue": 1
            },
            "vmSize": {
              "type": "string",
              "allowedValues": [
                "Standard_B1s",
                "Standard_B2s"
              ]
            },
            "adminUsername": {
              "type": "string"
            },
            "adminPassword": {
              "type": "securestring"
            },
            "subnetId": {
              "type": "string"
            },
            "tags": {
              "type": "object",
              "defaultValue": {}
            }
          },
          "variables": {
            "defaultTags": {
              "environment": "[parameters('environment')]",
              "app": "go-app",
              "managedBy": "Bicep"
            },
            "resourceTags": "[union(variables('defaultTags'), parameters('tags'))]"
          },
          "resources": [
            {
              "copy": {
                "name": "nics",
                "count": "[length(range(0, parameters('vmCount')))]"
              },
              "type": "Microsoft.Network/networkInterfaces",
              "apiVersion": "2023-05-01",
              "name": "[format('{0}-nic-{1}', parameters('environment'), range(0, parameters('vmCount'))[copyIndex()])]",
              "location": "[parameters('location')]",
              "tags": "[variables('resourceTags')]",
              "properties": {
                "ipConfigurations": [
                  {
                    "name": "ipconfig1",
                    "properties": {
                      "subnet": {
                        "id": "[parameters('subnetId')]"
                      },
                      "privateIPAllocationMethod": "Dynamic"
                    }
                  }
                ]
              }
            },
            {
              "copy": {
                "name": "vms",
                "count": "[length(range(0, parameters('vmCount')))]"
              },
              "type": "Microsoft.Compute/virtualMachines",
              "apiVersion": "2023-07-01",
              "name": "[format('{0}-vm-{1}', parameters('environment'), range(0, parameters('vmCount'))[copyIndex()])]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "hardwareProfile": {
                  "vmSize": "[parameters('vmSize')]"
                },
                "osProfile": {
                  "computerName": "[format('{0}-vm-{1}', parameters('environment'), range(0, parameters('vmCount'))[copyIndex()])]",
                  "adminUsername": "[parameters('adminUsername')]",
                  "adminPassword": "[parameters('adminPassword')]",
                  "linuxConfiguration": {
                    "disablePasswordAuthentication": false
                  }
                },
                "storageProfile": {
                  "imageReference": {
                    "publisher": "Canonical",
                    "offer": "0001-com-ubuntu-server-jammy",
                    "sku": "22_04-lts-gen2",
                    "version": "latest"
                  },
                  "osDisk": {
                    "createOption": "FromImage",
                    "managedDisk": {
                      "storageAccountType": "Standard_LRS"
                    }
                  }
                },
                "networkProfile": {
                  "networkInterfaces": [
                    {
                      "id": "[resourceId('Microsoft.Network/networkInterfaces', format('{0}-nic-{1}', parameters('environment'), range(0, parameters('vmCount'))[range(0, parameters('vmCount'))[copyIndex()]]))]"
                    }
                  ]
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/networkInterfaces', format('{0}-nic-{1}', parameters('environment'), range(0, parameters('vmCount'))[range(0, parameters('vmCount'))[copyIndex()]]))]"
              ]
            }
          ],
          "outputs": {
            "vmIds": {
              "type": "array",
              "copy": {
                "count": "[length(range(0, parameters('vmCount')))]",
                "input": "[resourceId('Microsoft.Compute/virtualMachines', format('{0}-vm-{1}', parameters('environment'), range(0, parameters('vmCount'))[range(0, parameters('vmCount'))[copyIndex()]]))]"
              }
            },
            "vmNames": {
              "type": "array",
              "copy": {
                "count": "[length(range(0, parameters('vmCount')))]",
                "input": "[format('{0}-vm-{1}', parameters('environment'), range(0, parameters('vmCount'))[range(0, parameters('vmCount'))[copyIndex()]])]"
              }
            },
            "privateIpAddresses": {
              "type": "array",
              "copy": {
                "count": "[length(range(0, parameters('vmCount')))]",
                "input": "[reference(resourceId('Microsoft.Network/networkInterfaces', format('{0}-nic-{1}', parameters('environment'), range(0, parameters('vmCount'))[range(0, parameters('vmCount'))[copyIndex()]])), '2023-05-01').ipConfigurations[0].properties.privateIPAddress]"
              }
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', 'networkingDeployment')]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "storageDeployment",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "environment": {
            "value": "[parameters('environment')]"
          },
          "deployStorage": {
            "value": "[parameters('deployStorage')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.48.1.52935",
              "templateHash": "17010088958891031380"
            },
            "name": "Storage Module",
            "description": "Storage Account and Blob Container",
            "version": "1.0.0"
          },
          "parameters": {
            "location": {
              "type": "string"
            },
            "environment": {
              "type": "string"
            },
            "deployStorage": {
              "type": "bool",
              "defaultValue": true
            },
            "tags": {
              "type": "object",
              "defaultValue": {}
            }
          },
          "variables": {
            "storageAccountName": "[format('{0}{1}', replace(parameters('environment'), '-', ''), uniqueString(resourceGroup().id))]",
            "storageTags": "[union(parameters('tags'), createObject('environment', parameters('environment'), 'managedBy', 'Bicep'))]"
          },
          "resources": [
            {
              "condition": "[parameters('deployStorage')]",
              "type": "Microsoft.Storage/storageAccounts",
              "apiVersion": "2023-01-01",
              "name": "[variables('storageAccountName')]",
              "location": "[parameters('location')]",
              "tags": "[variables('storageTags')]",
              "sku": {
                "name": "Standard_LRS"
              },
              "kind": "StorageV2",
              "properties": {
                "accessTier": "Hot",
                "allowBlobPublicAccess": false,
                "minimumTlsVersion": "TLS1_2"
              }
            }
          ],
          "outputs": {
            "storageAccountId": {
              "type": "string",
              "value": "[if(parameters('deployStorage'), resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '')]"
            },
            "storageAccountName": {
              "type": "string",
              "value": "[if(parameters('deployStorage'), variables('storageAccountName'), '')]"
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "keyvault-deployment",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "keyVaultName": {
            "value": "[format('kv-devops-{0}', uniqueString(resourceGroup().id))]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.48.1.52935",
              "templateHash": "17352565148157401801"
            },
            "description": "Reusable Key Vault module using the cost-safe Standard tier."
          },
          "parameters": {
            "keyVaultName": {
              "type": "string"
            },
            "location": {
              "type": "string",
              "defaultValue": "[resourceGroup().location]"
            },
            "tenantId": {
              "type": "string",
              "defaultValue": "[subscription().tenantId]"
            }
          },
          "resources": [
            {
              "type": "Microsoft.KeyVault/vaults",
              "apiVersion": "2023-07-01",
              "name": "[parameters('keyVaultName')]",
              "location": "[parameters('location')]",
              "properties": {
                "sku": {
                  "family": "A",
                  "name": "standard"
                },
                "tenantId": "[parameters('tenantId')]",
                "enableRbacAuthorization": true,
                "enabledForTemplateDeployment": true,
                "softDeleteRetentionInDays": 7
              }
            }
          ],
          "outputs": {
            "keyVaultId": {
              "type": "string",
              "value": "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]"
            },
            "keyVaultUri": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), '2023-07-01').vaultUri]"
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "acr-deployment",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "acrName": {
            "value": "[format('acrdevops{0}', uniqueString(resourceGroup().id))]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.48.1.52935",
              "templateHash": "7284547834192714140"
            },
            "description": "Reusable Azure Container Registry module using the cost-effective Basic tier."
          },
          "parameters": {
            "acrName": {
              "type": "string"
            },
            "location": {
              "type": "string",
              "defaultValue": "[resourceGroup().location]"
            }
          },
          "resources": [
            {
              "type": "Microsoft.ContainerRegistry/registries",
              "apiVersion": "2023-07-01",
              "name": "[parameters('acrName')]",
              "location": "[parameters('location')]",
              "sku": {
                "name": "Basic"
              },
              "properties": {
                "adminUserEnabled": true
              }
            }
          ],
          "outputs": {
            "acrId": {
              "type": "string",
              "value": "[resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName'))]"
            },
            "acrLoginServer": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName')), '2023-07-01').loginServer]"
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "vmIds": {
      "type": "array",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'computeDeployment'), '2025-04-01').outputs.vmIds.value]"
    },
    "vmNames": {
      "type": "array",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'computeDeployment'), '2025-04-01').outputs.vmNames.value]"
    },
    "privateIpAddresses": {
      "type": "array",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'computeDeployment'), '2025-04-01').outputs.privateIpAddresses.value]"
    },
    "vnetId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'networkingDeployment'), '2025-04-01').outputs.vnetId.value]"
    },
    "nsgId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'networkingDeployment'), '2025-04-01').outputs.nsgId.value]"
    },
    "storageAccountId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'storageDeployment'), '2025-04-01').outputs.storageAccountId.value]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'storageDeployment'), '2025-04-01').outputs.storageAccountName.value]"
    }
  }
}